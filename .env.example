# Exact origin of the admin panel (scheme + host + port, no path).
# Comma-separated list of exact origins is supported. Unset = edit-mode
# bridge rejects every admin message and frame-ancestors sends 'none'.
# Replace with the deployed admin origin before production.
NEXT_PUBLIC_ADMIN_ORIGIN=https://your-admin-domain.com   # exact origin of the admin panel; required for edit mode and frame-ancestors header
