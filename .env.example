# Exact origin of the admin panel (scheme + host + port, no path).
# Comma-separated list of exact origins is supported. Unset = edit-mode
# bridge rejects every admin message and frame-ancestors sends 'none'.
# Replace with the deployed admin origin before production.
NEXT_PUBLIC_ADMIN_ORIGIN=https://your-admin-domain.com   # exact origin of the admin panel; required for edit mode and frame-ancestors header

# On-demand revalidation (instant publish): server-only shared token
# verified by POST /api/revalidate; the admin sends it after each
# publish. Generate with `openssl rand -hex 32` and use the SAME value
# in the admin's env. Never NEXT_PUBLIC_, never committed, never logged.
REVALIDATE_SECRET=

# ── Paystack checkout (Tier 4) ────────────────────────────────
# The server ALSO needs Supabase access for the checkout RPCs (same
# two names the admin uses):
#   NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# (server-only — orders/coupons are deny-all RLS; the checkout API
# routes are the only gateway.)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PAYSTACK_SECRET_KEY: server-only. Read by src/lib/server/paystack.ts
# for /transaction/initialize, /transaction/verify and the webhook's
# HMAC-SHA512 signature check. Never NEXT_PUBLIC_, never logged, never
# in a response. Live-mode keys start sk_live_.
PAYSTACK_SECRET_KEY=

# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY: the PUBLIC checkout key only
# (pk_live_… / pk_test_…). Safe in the browser — it identifies the
# Paystack account, it can never charge.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# TEST-ONLY seam (approved Tier 4 plan): PAYSTACK_MOCK=1 answers the two
# outbound Paystack calls from .verify/paystack-mock-state.json instead
# of the network — automated verification never touches Paystack. The
# mock REFUSES to engage when VERCEL_ENV=production (checkout fails
# loudly rather than faking payments), and PAYSTACK_MOCK is never set
# in any deployment. Optional path override: PAYSTACK_MOCK_STATE_FILE.
# PAYSTACK_MOCK=1
